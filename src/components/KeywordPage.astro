---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
import { site, components } from '../data/site-data.json';

interface Props {
  id: string;
  title: string;
  heading: string;
  description: string;
  intro: string;
  cta: { label: string; href: string };
  sections: { h2: string; body: string }[];
  category?: string;
}

const { breadcrumbs } = components;
const baseUrl = site.url;
const { id, title, description, heading, intro, cta, sections } = Astro.props;
const pageUrl = `${baseUrl}/uses/${id}/`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: breadcrumbs.home, item: baseUrl },
    { "@type": "ListItem", position: 2, name: "Uses", item: `${baseUrl}/uses/` },
    { "@type": "ListItem", position: 3, name: heading, item: pageUrl }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={[breadcrumbJsonLd]}>
  <section class="animate-fade-in section-padding">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl text-center">
      <span class="section-label">USE CASE</span>
      <h1 class="mb-5 font-extrabold text-slate-900 text-4xl lg:text-5xl tracking-tight">
        {heading}
      </h1>
      <p class="mx-auto max-w-2xl text-slate-700 text-lg leading-relaxed">
        {intro}
      </p>
      <div class="mt-8">
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-700 px-7 py-3.5 rounded-xl font-semibold text-white transition-colors"
        >
          {cta.label}
          &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 section-padding">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
      {sections.map((section) => (
        <div class="mb-10">
          <h2 class="mb-3 font-bold text-slate-900 text-2xl">{section.h2}</h2>
          <p class="text-slate-700 text-base leading-relaxed">{section.body}</p>
        </div>
      ))}
      <div class="mt-12 text-center">
        <a
          href={cta.href}
          class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-700 px-7 py-3.5 rounded-xl font-semibold text-white transition-colors"
        >
          {cta.label}
          &rarr;
        </a>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
