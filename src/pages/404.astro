---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site-data.json';
---

<BaseLayout title="Page Not Found" description="The page you are looking for could not be found.">
  <section class="bg-white section-padding">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl text-center">
      <div class="mb-6">
        <span class="inline-flex items-center justify-center bg-brand-50 rounded-full w-24 h-24">
          <svg class="w-12 h-12 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </span>
      </div>
      <h1 class="mb-4 font-extrabold text-slate-900 text-7xl tracking-tight">404</h1>
      <p class="mb-2 font-semibold text-slate-800 text-xl">Page not found</p>
      <p class="mb-8 text-slate-600 leading-relaxed">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
      <div class="flex sm:flex-row flex-col justify-center gap-3">
        <a
          href="/"
          class="inline-flex justify-center items-center gap-2 bg-slate-900 hover:bg-slate-700 px-6 py-3 rounded-xl font-semibold text-white text-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Go to homepage
        </a>
        <a
          href="/documentation/"
          class="inline-flex justify-center items-center gap-2 bg-white hover:bg-slate-50 px-6 py-3 border border-slate-200 hover:border-slate-300 rounded-xl font-semibold text-slate-700 text-sm transition-colors"
        >
          Browse documentation
        </a>
      </div>
    </div>
  </section>
</BaseLayout>